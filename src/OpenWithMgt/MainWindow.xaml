<Window x:Class="OpenWithMgt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWithMgt - 右键菜单管理" Width="1020" Height="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="200"/>
                <DataGridTextColumn Header="作用于" Binding="{Binding ScopeText}" Width="150"/>
                <DataGridTextColumn Header="键名" Binding="{Binding KeyName}" Width="140"/>
                <DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="*"/>
                <DataGridTextColumn Header="图标" Binding="{Binding Icon}" Width="130"/>
                <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="125"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="1" Header="添加新项（只需先选程序，其余自动填充）" Margin="0,8,0,8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="程序路径:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="4"
                         Text="{Binding NewExePath, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="0" Grid.Column="4" Content="浏览…" Margin="4" Padding="12,2"
                        Command="{Binding BrowseExeCommand}"/>

                <Label Grid.Row="1" Grid.Column="0" Content="键名:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="4"
                         Text="{Binding NewKeyName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="注册表键名，用于程序内部标识"/>
                <Label Grid.Row="1" Grid.Column="2" Content="显示名称:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="3" Margin="4"
                         Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="菜单上显示的文字，留空则使用键名"/>

                <Label Grid.Row="2" Grid.Column="0" Content="参数:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="4"
                         Text="{Binding NewArguments, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="%1 表示被右键点击的文件路径"/>
                <Label Grid.Row="2" Grid.Column="2" Content="图标:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="3" Margin="4"
                         Text="{Binding NewIconPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="可选，默认为所选程序的图标"/>

                <Label Grid.Row="3" Grid.Column="0" Content="添加到:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="4" HorizontalAlignment="Left" Width="220"
                          SelectedIndex="{Binding NewScopeIndex}">
                    <ComboBoxItem Content="当前用户 (HKCU)"/>
                    <ComboBoxItem Content="所有用户 (HKLM，需管理员)"/>
                </ComboBox>
                <Button Grid.Row="3" Grid.Column="3" Content="添加" Margin="4" Padding="20,2"
                        HorizontalAlignment="Right" Command="{Binding AddCommand}"/>
            </Grid>
        </GroupBox>

        <DockPanel Grid.Row="2" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="刷新" Padding="16,4" Margin="0,0,8,0"
                    Command="{Binding RefreshCommand}"/>
            <Button DockPanel.Dock="Left" Content="删除选中项" Padding="16,4"
                    Command="{Binding DeleteCommand}"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
